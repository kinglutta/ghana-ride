# YENKO RIDE backend configuration

PORT=3000
NODE_ENV=development
MONGODB_URL=mongodb://127.0.0.1:27017/yenko_ride

JWT_SECRET=replace-with-a-random-32-character-minimum-secret
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Admin onboarding
# Comma-separated invite codes. The onboarding screen asks for one when a user
# chooses "Operations". Nothing is sent to the browser.
# Development falls back to YENKO-ADMIN-2026 when this is unset.
# Production has no fallback — set at least one code before deploying.
ADMIN_SIGNUP_CODES=YENKO-ADMIN-2026

# Existing admin bootstrap (optional)
ADMIN_EMAIL=admin@yenko.test
ADMIN_PASSWORD=Admin12345
