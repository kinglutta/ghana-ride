# Copy to Backend/.env for local development. Never commit the real .env file.
NODE_ENV=development
PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017/yenko_ride
JWT_SECRET=replace-with-a-random-32-character-secret
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:5173

# Server-side only. Never expose in the frontend or in Vercel variables.
ADMIN_SIGNUP_CODES=replace-with-a-private-admin-code

# Optional: used only when seeding an admin locally.
ADMIN_EMAIL=admin@yenko.test
ADMIN_PASSWORD=replace-with-a-strong-password
